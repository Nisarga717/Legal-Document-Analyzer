# -- MongoDB ------------------------------------------------------------------
# Local:   MONGO_URI=mongodb://localhost:27017/legaldoc
# Atlas:   MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/legaldoc?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/legaldoc

# -- JWT -----------------------------------------------------------------------
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_random_secret_string

# -- Gemini AI ----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: pin a specific model (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# -- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# -- CORS ---------------------------------------------------------------------
# Set this in Render dashboard to your Netlify URL (comma-separated if multiple)
# FRONTEND_URL=https://your-app.netlify.app
